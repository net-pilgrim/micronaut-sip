	<!-- This is the Menu block -->
	<form id="Room2">
		<property name="termchar" value="D"/>
		<property name="inputmodes" value="dtmf" />
		<property name="bargein" value="true" />
		<property name="bargeintype" value="speech" /> 		    									   
		<block name="Room2P0">
  			<prompt>
				You enetered a room. There is a goblin inside that is offering you an enchanted sword. For you to have the sword you must answer the following question: "Is pi greater than three?".
Press 1 for true or 2 for false. 		
    		</prompt>
		</block>
		 
		<field name="Room2Option">
			<property name="timeout" value="10s" />
			<option dtmf="1" value="1" />
			<option dtmf="2" value="2" />
  		</field>
