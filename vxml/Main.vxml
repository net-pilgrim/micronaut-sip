		<property name="bargeintype" value="speech" /> 		    									   
		<block name="Room9P0">
  			<prompt>
				You have a come a long way prince.
Now you have only two choices:
1 for sure death and 2 with a fight with the warlock		
    		</prompt>
		</block>
		 
		<field name="Room9Option">
			<property name="timeout" value="10s" />
			<option dtmf="1" value="1" />
			<option dtmf="2" value="2" />
  		</field>
		<filled mode="all" namelist="Room9Option">
			<assign name="AppState.Room9" expr="Room9Option" />  			
					<if cond="Room9Option == '1'">
				<goto next="#Abyss" />
			</if>
					<if cond="Room9Option == '2'">
				<goto next="#Branching2" />
			</if>
		</filled>
		<catch event="noinput" count="1">
	  		<throw event="com.genesyslab.composer.toomanynoinputs" message="exceeded the number of noinput retries" />
	  	</catch>
		<catch event="nomatch" count="1">
	  		<throw event="com.genesyslab.composer.toomanynomatches" message="exceeded the number of nomatch retries" />
	  	</catch>
	</form>

	<!-- This is the Assign block -->
	<form id="Assign1">
		<block>
			
			<assign name="AppState.spellpower" expr="1" />	
			<goto next="#Room9" />
		</block>
	</form>

	<!-- This is the Assign block -->
	<form id="Assign2">
		<block>
			
			<assign name="AppState.spellpower" expr="2" />	
			<goto next="#Room9" />
		</block>
	</form>

