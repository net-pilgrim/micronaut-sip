    	</block>
	</form>

	<!-- This is the Branching block -->
	<form id="Branching1">
		<block>
			<if cond="AppState.sword == true">
				<!-- This is the OutLink -->
				<goto next="#OrcWin" />
			</if>
			<goto next="#OrcLoose" />
		</block>
	</form>

	<!-- This is the Prompt block -->
	<form id="OrcWin">
    	<block name="OrcWinP0">
