		</block>
	</form>

	<!-- This is the Input block -->
	<form id="Input1">
		<property name="inputmodes" value="dtmf" />
		<property name="bargein" value="true" />
		<property name="bargeintype" value="speech" /> 
		<block name="Input1P0">
  			<prompt>
				Wellcome to the VxmlMaze! The Media princess, daughter of the Application Emperror was kidnaped and held into a dark dungeon by a villain warlock. 		
				You, a mighty prince, have to rescue her hoping for her  hand in marriage and some market share in the applications field. Your quest begins now!		
    		</prompt>
		</block>
		
		 
		<field name="Input1Field" type="digits?minlength=1;maxlength=1">
			<property name="interdigittimeout" value="1s" />
			<property name="termchar" value="#" /> 
			<property name="timeout" value="1s" />
		</field>
    	<filled mode="all" namelist="Input1Field">
    		<assign name="AppState.Input1" expr="Input1Field" />
    		<goto next="#Prompt2" />
    	</filled>
		
		<catch event="noinput" count="1">
	  		<throw event="com.genesyslab.composer.toomanynoinputs" message="exceeded the number of noinput retries" />
	  	</catch>
		<catch event="nomatch" count="1">
	  		<throw event="com.genesyslab.composer.toomanynomatches" message="exceeded the number of nomatch retries" />
	  	</catch>
		<catch event="com.genesyslab.composer.toomanynoinputs">
			<goto next="#Prompt2" />
    	</catch>
		<catch event="com.genesyslab.composer.toomanynomatches">
			<goto next="#Prompt2" />
    	</catch>
	</form>

